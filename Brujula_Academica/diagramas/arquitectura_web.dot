digraph G { rankdir=TB; bgcolor="#ffffff"; graph [fontname="Arial", labelloc="t", label="Arquitectura conceptual por capas - Brújula Académica", fontsize=18, pad=0.25, nodesep=0.35, ranksep=0.55]; node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, margin="0.16,0.11", color="#24566A", fillcolor="#EAF4F6", fontcolor="#163746"]; edge [color="#527887", arrowsize=0.7, fontname="Arial", fontsize=9];
subgraph cluster_client {label="Presentación"; style="rounded,dashed"; color="#A7C6D1"; browser [label="Prototipo web responsive\nEstudiante | Asesor | Coordinación", fillcolor="#DCEFF4"]}
subgraph cluster_api {label="Aplicación"; style="rounded,dashed"; color="#A7C6D1"; gateway [label="API REST\nAutenticación y validación"]; services [label="Servicios de aplicación\nPerfiles • Catálogo • Feedback"]; recommender [label="Motor de recomendaciones\nReglas transparentes + explicación", fillcolor="#FFF2CF", color="#C7922A"]}
subgraph cluster_data {label="Dominio semántico y persistencia"; style="rounded,dashed"; color="#A7C6D1"; relational [label="Base relacional\nPerfiles y catálogo sintético"]; ontology [label="Ontología OWL / Protégé\nClases • Propiedades • Restricciones", fillcolor="#E5F4E8", color="#3E8A63"]; graphdb [label="Grafo Neo4j\nRelaciones y consultas Cypher", fillcolor="#E5F4E8", color="#3E8A63"]}
external [label="Interoperabilidad opcional\nSOAP/WSDL", fillcolor="#F0EAFE", color="#7A65B1"];
browser -> gateway [label="HTTPS / JSON"]; gateway -> services; services -> relational [dir=both,label="CRUD validado"]; services -> recommender; recommender -> ontology [label="conceptos / reglas"]; recommender -> graphdb [label="relaciones / recomendación"]; services -> external [dir=both,label="adaptador legado",style=dashed]; graphdb -> recommender [label="candidatos",dir=back]; }